{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI paper validation worker result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "paper_package",
    "run_status",
    "source_pdf_count",
    "candidate_count",
    "candidate_index",
    "statistical_audit",
    "artifacts",
    "human_adjudication_required",
    "notes"
  ],
  "properties": {
    "paper_package": {"type": "string", "minLength": 1},
    "run_status": {
      "type": "string",
      "enum": ["COMPLETED", "FAILED", "NEEDS_HUMAN_INPUT"]
    },
    "source_pdf_count": {"type": "integer", "minimum": 1},
    "candidate_count": {"type": "integer", "minimum": 0},
    "candidate_index": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "candidate_statement",
          "report_anchor",
          "evidence_card_complete",
          "pdf_page_links"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^C[0-9]{3,}$"},
          "category": {
            "type": "string",
            "enum": [
              "Arithmetic inconsistency",
              "Cross-document inconsistency",
              "Statistical reporting inconsistency",
              "Participant flow inconsistency",
              "Presentation inconsistency"
            ]
          },
          "candidate_statement": {"type": "string", "minLength": 1},
          "report_anchor": {"type": "string", "pattern": "^#C[0-9]{3,}$"},
          "evidence_card_complete": {"type": "boolean"},
          "pdf_page_links": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "\\.pdf#page=[1-9][0-9]*$"}
          }
        }
      }
    },
    "statistical_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reported_relationships_checked",
        "relationships_not_mechanically_checkable",
        "candidate_count",
        "first_pass_completed",
        "second_pass_completed",
        "coverage_artifact"
      ],
      "properties": {
        "reported_relationships_checked": {"type": "integer", "minimum": 0},
        "relationships_not_mechanically_checkable": {"type": "integer", "minimum": 0},
        "candidate_count": {"type": "integer", "minimum": 0},
        "first_pass_completed": {"const": true},
        "second_pass_completed": {"const": true},
        "coverage_artifact": {"const": "audit/statistics/coverage_matrix.md"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_manifest",
        "run_metadata",
        "context_coverage",
        "candidate_registry",
        "evidence_recheck",
        "evidence_quality_audit",
        "final_report_markdown",
        "final_report_html",
        "audit_validation"
      ],
      "properties": {
        "package_manifest": {"const": "audit/package_manifest.md"},
        "run_metadata": {"const": "audit/run_metadata.json"},
        "context_coverage": {"const": "audit/context_coverage.md"},
        "candidate_registry": {"const": "audit/candidate_registry.md"},
        "evidence_recheck": {"const": "audit/verification/evidence_recheck.md"},
        "evidence_quality_audit": {"const": "audit/quality/evidence_quality_audit.md"},
        "final_report_markdown": {"const": "audit/final_report.md"},
        "final_report_html": {"const": "audit/final_report.html"},
        "audit_validation": {"const": "audit/audit_validation.json"}
      }
    },
    "human_adjudication_required": {"const": true},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
