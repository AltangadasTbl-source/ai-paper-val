# Allow only reviewed, repeatable commands used by the shared paper-audit workflow.

prefix_rule(
    pattern = ["nvidia-smi"],
    decision = "allow",
    justification = "Read-only NVIDIA GPU and driver inspection for configured GPU OCR.",
)

prefix_rule(
    pattern = [
        ["python", "python3", "py", "~/venvs/stt/bin/python"],
        [
            ".agents/skills/ai-validation/scripts/run_ocr.py",
            "../.agents/skills/ai-validation/scripts/run_ocr.py",
        ],
    ],
    decision = "allow",
    justification = "Run the reviewed exact-backend OCR helper for one package.",
)

prefix_rule(
    pattern = [
        ["python", "python3", "py", "~/venvs/stt/bin/python"],
        [
            ".agents/skills/ai-validation/scripts/convert_office_to_pdf.py",
            "../.agents/skills/ai-validation/scripts/convert_office_to_pdf.py",
        ],
    ],
    decision = "allow",
    justification = "Convert supplied Office documents to derived PDFs without modifying sources.",
)

prefix_rule(
    pattern = [
        ["python", "python3", "py", "~/venvs/stt/bin/python"],
        [
            ".agents/skills/ai-validation/scripts/render_report.py",
            "../.agents/skills/ai-validation/scripts/render_report.py",
        ],
    ],
    decision = "allow",
    justification = "Render the local source-linked Markdown report as standalone HTML.",
)

prefix_rule(
    pattern = [
        ["python", "python3", "py", "~/venvs/stt/bin/python"],
        [
            ".agents/skills/ai-validation/scripts/validate_audit.py",
            "../.agents/skills/ai-validation/scripts/validate_audit.py",
        ],
    ],
    decision = "allow",
    justification = "Validate local audit artifacts and PDF page links.",
)

prefix_rule(
    pattern = [
        ["python", "python3", "py", "~/venvs/stt/bin/python"],
        "batch/run_batch.py",
    ],
    decision = "allow",
    justification = "Launch isolated paper agents with the reviewed thin worker-pool launcher.",
)

prefix_rule(
    pattern = [
        ["powershell", "powershell.exe", "pwsh"],
        "-NoProfile",
        "-File",
        [
            ".agents/skills/ai-validation/scripts/windows_tools.ps1",
            "../.agents/skills/ai-validation/scripts/windows_tools.ps1",
        ],
    ],
    decision = "allow",
    justification = "Run only the reviewed Windows GPU or Office-conversion helper.",
)

prefix_rule(
    pattern = ["pdftotext"],
    decision = "allow",
    justification = "Extract local PDF text into the current package audit directory.",
)

prefix_rule(
    pattern = ["pdfinfo"],
    decision = "allow",
    justification = "Inspect local PDF metadata and page counts.",
)

prefix_rule(
    pattern = [["pdftoppm", "pdftocairo"]],
    decision = "allow",
    justification = "Render local PDF pages into the current package audit directory.",
)

prefix_rule(
    pattern = ["pandoc"],
    decision = "allow",
    justification = "Render the local report as standalone HTML.",
)

prefix_rule(
    pattern = [["sha256sum", "Get-FileHash"]],
    decision = "allow",
    justification = "Compute reproducibility hashes for supplied package files.",
)
