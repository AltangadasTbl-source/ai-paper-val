# Reviewed commands for autonomous CPU-only legacy recovery.

prefix_rule(
    pattern = [
        ["python", "python3"],
        [
            "legacy_patch/scripts/prepare_recovery.py",
            "legacy_patch/scripts/extract_office_source.py",
            "legacy_patch/scripts/render_report.py",
            "legacy_patch/scripts/validate_patch.py",
        ],
    ],
    decision = "allow",
    justification = "Inventory, extract targeted Office evidence, render, and validate one local legacy paper package.",
)

prefix_rule(
    pattern = ["pdftotext"],
    decision = "allow",
    justification = "Targeted local native-text extraction for an exact cited PDF page.",
)

prefix_rule(
    pattern = ["pdfinfo"],
    decision = "allow",
    justification = "Read local PDF metadata and page counts.",
)

prefix_rule(
    pattern = [["pdftoppm", "pdftocairo"]],
    decision = "allow",
    justification = "Render only exact local PDF pages required for candidate rechecking.",
)

prefix_rule(
    pattern = ["tesseract"],
    decision = "allow",
    justification = "Run targeted CPU-only OCR for an exact page when legacy OCR is unusable.",
)

prefix_rule(
    pattern = ["pandoc"],
    decision = "allow",
    justification = "Render the versioned local recovery report as standalone HTML.",
)

prefix_rule(
    pattern = ["sha256sum"],
    decision = "allow",
    justification = "Verify that supplied sources and legacy artifacts remain unchanged.",
)
