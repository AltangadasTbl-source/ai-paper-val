85546875, 498.991943359375], [1479.752685546875, 535.5846557617188], [199.21875, 535.5846557617188]], 'by the NRN, 97% in the SUPPORT study and 98% in the GDB registry for the first few months', 0.9858813647473796], [[[199.21875, 537.8024291992188], [1470.8984375, 536.6935424804688], [1470.8984375, 568.850830078125], [199.21875, 569.9596557617188]], 'of 2016 received the first dose of surfactant within 48h; 91% in the first day, 99% by 72h; 55%', 0.986738257659109], [[[199.21875, 576.6129150390625], [1490.8203125, 576.6129150390625], [1490.8203125, 608.7701416015625], [199.21875, 608.7701416015625]], 'in SUPPORT received just 1 dose). Attempts will be made to obtain antenatal consent, but if not', 0.9831401592806766], [[[198.1119842529297, 615.4234008789062], [1479.752685546875, 614.3145141601562], [1479.752685546875, 647.5806274414062], [198.1119842529297, 648.6895141601562]], 'possible, postnatal consent will also be sought to maximize enrollment. A +2h grace period will', 0.9882027933472082], [[[198.1119842529297, 652.01611328125], [1459.830810546875, 653.125], [1459.830810546875, 686.39111328125], [198.1119842529297, 685.2822875976562]], 'be allotted for attaining and administering the dose (study drug may be administered up to 50h', 0.9940380599904568], [[[199.21875, 689.7177734375], [1435.4818115234375, 688.60888671875], [1435.4818115234375, 725.2015991210938], [199.21875, 726.3104858398438]], 'after birth). Of 376 infants in GDB in early 2016 on whom we have data, only 31% received', 0.9829416382178832], [[[198.1119842529297, 728.5282592773438], [1487.5, 727.4193725585938], [1487.5, 764.0120849609375], [198.1119842529297, 765.1209716796875]], 'surfactant in the delivery room (DR) although there is likely to be center variation, so two-thirds', 0.9832983920068452], [[[199.21875, 768.4475708007812], [1499.674560546875, 767.3387451171875], [1499.674560546875, 800.6048583984375], [199.21875, 801.7137451171875]], 'may receive surfactant later; the rate of BPD/death is 59% in those who received surfactant in the', 0.9861726961573776], [[[199.21875, 805.0403442382812], [1380.143310546875, 807.258056640625], [1380.143310546875, 840.5242309570312], [199.21875, 838.3064575195312]], 'DR vs. 65% in those who received surfactant later, so there does not appear to be a large', 0.9845112327779277], [[[200.32553100585938, 843.850830078125], [1345.8333740234375, 844.959716796875], [1345.8333740234375, 878.225830078125], [200.32553100585938, 877.116943359375]], 'difference in risk of BPD between DR surfactant and NICU surfactant administration.', 0.9920418987791222], [[[200.32553100585938, 914.8185424804688], [1465.3646240234375, 915.9274291992188], [1465.3646240234375, 949.1935424804688], [200.32553100585938, 948.084716796875]], 'All infants enrolled in this study must also be consented and enrolled in the GDB registry, thus', 0.985364738230904], [[[201.4322967529297, 955.8468017578125], [1196.4193115234375, 955.8468017578125], [1196.4193115234375, 989.1129150390625], [201.4322967529297, 989.1129150390625]], 'all data collected through the GDB registry will be available for this study.', 0.9920195999083581], [[[200.32553100585938, 1025.7056884765625], [688.4114990234375, 1026.8145751953125], [688.4114990234375, 1058.9718017578125], [200.32553100585938, 1057.8629150390625]], '4.2.3. Randomization Procedures', 0.9952283655443499], [[[200.32553100585938, 1080.040283203125], [1438.8021240234375, 1082.258056640625], [1438.8021240234375, 1115.524169921875], [200.32553100585938, 1113.3065185546875]], 'Due to the frequent need to administer surfactant to extremely preterm infants in the delivery', 0.9905827203963665], [[[198.1119842529297, 1122.177490234375], [1433.268310546875, 1118.850830078125], [1433.268310546875, 1151.008056640625], [198.1119842529297, 1154.334716796875]], 'room, treatment assignments must be made in an expeditious manner in order to enroll these', 0.9840574959913889], [[[198.1119842529297, 1155.443603515625], [1371.2890625, 1156.552490234375], [1371.2890625, 1193.1451416015625], [198.1119842529297, 1192.0362548828125]], 'infants in the study, while also maintaining balanced allocation of the infants to the two', 0.9856671141253577], [[[197.00521850585938, 1195.3629150390625], [1489.713623046875, 1197.5806884765625], [1489.713623046875, 1230.8468017578125], [197.00521850585938, 1228.6290283203125]], 'treatment arms. If these infants are not enrolled because of time constraints in the delivery room,', 0.9915562446671303], [[[199.21875, 1235.2822265625], [1333.658935546875, 1235.2822265625], [1333.658935546875, 1268.5484619140625], [199.21875, 1268.5484619140625]], 'then inferences may not be generalizable to such infants and enrollment may become', 0.9953390781472369], [[[200.32553100585938, 1270.76611328125], [457.09637451171875, 1272.98388671875], [457.09637451171875, 1309.57666015625], [200.32553100585938, 1307.35888671875]], 'unacceptably slow.', 0.998222162326177], [[[197.00521850585938, 1341.73388671875], [1446.549560546875, 1340.625], [1446.549560546875, 1377.2177734375], [197.00521850585938, 1378.32666015625]], 'To address this issue, the BiB trial adapts the step-forward randomization idea of "Use Next"', 0.97237644849285], [[[200.32553100585938, 1381.6531982421875], [1495.2474365234375, 1380.54443359375], [1495.2474365234375, 1417.1370849609375], [200.32553100585938, 1418.2459716796875]], 'drug kits, which was originally presented by Zhao et al. (33). Based on a randomization schedule', 0.9974869154393673], [[[201.4322967529297, 1421.5726318359375], [1346.940185546875, 1421.5726318359375], [1346.940185546875, 1453.7298583984375], [201.4322967529297, 1453.7298583984375]], 'centrally generated by the NRN Data Coordinating Center (DCC) at RTI, drug kits of', 0.9801507272371431], [[[199.21875, 1458.165283203125], [1383.463623046875, 1459.274169921875], [1383.463623046875, 1492.540283203125], [199.21875, 1491.4315185546875]], 'budesonide respules or sham will be randomized, assembled, masked, and labeled by the', 0.9981013227911556], [[[200.32553100585938, 1498.084716796875], [1457.6171875, 1498.084716796875], [1457.6171875, 1531.350830078125], [200.32553100585938, 1531.350830078125]], 'Investigational Drug/Research Pharmacy at each site, then stored in a locked location that will', 0.9804609926123368], [[[198.1119842529297, 1533.568603515625], [1454.296875, 1535.7862548828125], [1454.296875, 1573.4879150390625], [198.1119842529297, 1571.2701416015625]], 'allow for rapid access by the respiratory therapist (or other qualified designated person). Drug', 0.9944917211929957], [[[199.21875, 1574.5968017578125], [1421.09375, 1574.5968017578125], [1421.09375, 1607.8629150390625], [199.21875, 1607.8629150390625]], 'kits will be added to the queue such that there are at least three sets of kits available in each', 0.992621386788555], [[[198.1119842529297, 1613.4072265625], [1483.072998046875, 1610.0806884765625], [1483.072998046875, 1646.6734619140625], [198.1119842529297, 1650.0]], 'gestational age stratum at a given time, and the Investigational Drug/Research Pharmacy will be', 0.9936522835179379], [[[199.21875, 1651.10888671875], [1438.8021240234375, 1650.0], [1438.8021240234375, 1686.5927734375], [199.21875, 1687.70166015625]], 'responsible for ordering, stocking, and supplying the respules of budesonide and sham to the', 0.9878160279730092], [[[198.1119842529297, 1688.810546875], [1489.713623046875, 1688.810546875], [1489.713623046875, 1724.29443359375], [198.1119842529297, 1724.29443359375]], 'NICU in the drug kits. Two drug kits will be prepared for each randomization number in case of', 0.9883931399659908], [[[197.00521850585938, 1725.4031982421875], [1436.588623046875, 1726.5120849609375], [1436.588623046875, 1763.1048583984375], [197.00521850585938, 1761.9959716796875]], 'the need for a second dose of study drug within the treatment window, thus a set of drug kits', 0.9909502440883268], [[[198.1119842529297, 1764.2137451171875], [1466.471