# Reviewed commands for agent-first local quantitative quality control.

prefix_rule(
    pattern = [
        ["python", "python3"],
        [
            "workflow_1_3_1/scripts/extract_office_source.py",
            "workflow_1_3_1/scripts/render_report.py",
            "workflow_1_3_1/scripts/validate_review.py",
        ],
    ],
    decision = "allow",
    justification = "Optionally extract Office structure, render the local report, and mechanically validate one review.",
)

prefix_rule(pattern = ["pdfinfo"], decision = "allow", justification = "Read local PDF metadata and page counts.")
prefix_rule(pattern = ["pdftotext"], decision = "allow", justification = "Extract local native or layout-preserving PDF text.")
prefix_rule(pattern = [["pdftoppm", "pdftocairo"]], decision = "allow", justification = "Render exact local PDF pages for visual confirmation or CPU OCR.")
prefix_rule(pattern = ["tesseract"], decision = "allow", justification = "Run targeted CPU-only OCR on exact local page images.")
prefix_rule(pattern = [["libreoffice", "soffice"]], decision = "allow", justification = "Create local derived views of supplied Office files without modifying sources.")
prefix_rule(pattern = ["pandoc"], decision = "allow", justification = "Render a standalone local HTML quality-control report.")
prefix_rule(pattern = ["sha256sum"], decision = "allow", justification = "Record and verify source and reused-artifact integrity.")
